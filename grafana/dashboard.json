    {
      "datasource": {
        "type": "postgres",
        "uid": "default"
      },
      "description": "Usa los switches para encender o apagar los LEDs en el hardware. El simulador detectará el cambio en tiempo real.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "id": 8,
      "options": {
        "buttonGroup": {
          "orientation": "center",
          "size": "md"
        },
        "css": "button[title*='Save'], button[title*='Reset'], button[aria-label*='Save'], button[aria-label*='Reset'] { display: none !important; }",
        "elements": [
          {
            "id": "led1",
            "title": "LED 1 — Luz de Operación",
            "type": "boolean",
            "uid": "led1_switch",
            "width": 12
          },
          {
            "id": "led2",
            "title": "LED 2 — Luz de Advertencia",
            "type": "boolean",
            "uid": "led2_switch",
            "width": 12
          }
        ],
        "initial": {
          "code": "return {};",
          "contentType": "application/json",
          "getPayload": "return {};",
          "highlight": false,
          "highlightColor": "red",
          "method": "-"
        },
        "layout": {
          "orientation": "horizontal",
          "padding": 10,
          "variant": "single"
        },
        "reset": {
          "backgroundColor": "purple",
          "foregroundColor": "yellow",
          "icon": "process",
          "text": "Reset",
          "variant": "hidden"
        },
        "resetAction": {
          "code": "console.log('resetAction running');",
          "mode": "initial"
        },
        "resetButton": {
          "icon": "",
          "text": "",
          "variant": "hidden"
        },
        "saveDefault": {
          "icon": "save",
          "text": "Save Default",
          "variant": "hidden"
        },
        "saveDefaultButton": {
          "icon": "",
          "text": "",
          "variant": "hidden"
        },
        "submit": {
          "backgroundColor": "purple",
          "foregroundColor": "yellow",
          "icon": "cloud-upload",
          "text": "Submit",
          "variant": "primary"
        },
        "submitButton": {
          "icon": "send",
          "text": "Enviar Comandos al Hardware",
          "variant": "primary"
        },
        "sync": true,
        "update": {
          "code": "(async () => {\n  try {\n    const getUrl = () => { if (typeof replaceVariables === 'function') return replaceVariables('${control_url}'); if (typeof context !== 'undefined' && context.grafana && context.grafana.replaceVariables) return context.grafana.replaceVariables('${control_url}'); return '${control_url}'; };\n    const controlUrl = getUrl();\n    const panelElements = typeof context !== 'undefined' && context.panel && context.panel.elements ? context.panel.elements : (typeof elements !== 'undefined' ? elements : []);\n\n    for (const el of panelElements) {\n      if (el.id === 'led1' || el.id === 'led2') {\n        const currentVal = el.value === true || el.value === 1 || el.value === 'true';\n        const storedVal = localStorage.getItem('sf_' + el.id) === 'true';\n        if (currentVal !== storedVal) {\n          const state = currentVal ? 1 : 0;\n          const payload = { led_id: el.id, state: state, source: 'grafana' };\n          // Enviar a AWS\n          await fetch(controlUrl, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });\n          // Enviar también al receiver local para mantener DB local sincronizada\n          try { await fetch('http://localhost:8080/control', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) }); } catch(e) {}\n          localStorage.setItem('sf_' + el.id, currentVal ? 'true' : 'false');\n          console.log('Enviado y guardado:', el.id, state);\n        }\n      }\n    }\n    const notOk = typeof context !== 'undefined' && context.grafana ? context.grafana.notifySuccess : notifySuccess;\n    if (notOk) notOk(['Control enviado', 'El hardware ha recibido el comando.']);\n  } catch (error) {\n    console.error('Error en update:', error);\n    const notErr = typeof context !== 'undefined' && context.grafana ? context.grafana.notifyError : notifyError;\n    if (notErr) notErr(['Error', error.toString()]);\n  }\n})()",
          "confirm": false,
          "contentType": "application/json",
          "getPayload": "return {};",
          "method": "-",
          "mode": "custom",
          "payloadMode": "all"
        }
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT CASE WHEN COALESCE((SELECT state FROM control_commands WHERE led_id = 'led1' ORDER BY command_timestamp DESC LIMIT 1), 0) = 1 THEN true ELSE false END AS led1, CASE WHEN COALESCE((SELECT state FROM control_commands WHERE led_id = 'led2' ORDER BY command_timestamp DESC LIMIT 1), 0) = 1 THEN true ELSE false END AS led2",
          "refId": "A"
        }
      ],
      "title": "Panel de Control — LEDs de Hardware",
      "type": "volkovlabs-form-panel"
    }
